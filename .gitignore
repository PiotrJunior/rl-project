# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Experiment outputs: raw per-run artifacts are large and regenerable.
# Aggregated summaries under results/summaries/ ARE committed (see !rules below).
results/runs/
results/smoke/
results/**/checkpoints/
*.pt
*.ckpt

# Keep committed summaries and figures
!results/summaries/
!results/summaries/**
!report/figures/**

# LaTeX build artifacts (paper.pdf is a build output, not a source)
paper/*.aux
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/*.toc
paper/*.bbl
paper/*.blg
paper/paper.pdf

# OS / editor
.DS_Store
.idea/
.vscode/
